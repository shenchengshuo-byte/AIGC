{
  "manifest_version": 3,
  "name": "TikTok TOP100 链接采集助手",
  "version": "1.0.0",
  "description": "在你自己的已登录TikTok页面读取可见的视频链接。仅本地保存；不读取密码、Cookie或登录令牌。",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://www.tiktok.com/search*"], "js": ["shared.js", "content.js"], "run_at": "document_idle"}]
}
